# ArgoCD connection settings for the GitOps control helper.
# Copy to `.env` and fill in real values. Never commit `.env`.

# ArgoCD API server (host:port, no scheme).
ARGOCD_SERVER=localhost:8080

# Bearer token generated via `argocd account generate-token`.
ARGOCD_AUTH_TOKEN=

# Skip TLS verification (true for local/self-signed, false in production).
ARGOCD_INSECURE=true

# Per-request timeout in seconds.
ARGOCD_TIMEOUT=30

# Helper behaviour.
GITOPS_DEFAULT_PROJECT=platform
GITOPS_SYNC_TIMEOUT=300
GITOPS_LOG_LEVEL=INFO
